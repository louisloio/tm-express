generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OnboardingStatus {
  PENDING_DVLA
  APPROVED
}

enum DocumentType {
  PMI
  BRAKE_TEST
  MOT
  VED
  INSURANCE
  LICENCE_CHECK
  CPC
  INFRINGEMENT_REPORT
  DEPOT_VISIT_NOTE
  OTHER
}

enum FollowUpStatus {
  NONE
  OPEN
  RESOLVED
}

enum TodoType {
  MISSING_DOCUMENT
  OVERDUE_DOCUMENT
  VISIT_OVERDUE
  ONBOARDING_STEP
  OCRS_MOVEMENT
  INFRINGEMENT
}

enum TodoStatus {
  OPEN
  RESOLVED
}

enum OcrsBand {
  GREEN
  AMBER
  RED
  GREY
  BLUE
}

// Client compliance status (Green/Amber/Red) is computed from due dates and
// document freshness, not stored — see Phase 1 build order step 5.
model Client {
  id                     String           @id @default(cuid())
  companyName            String
  companyNumber          String?
  vatNumber              String?
  olNumber               String?
  address                String?
  operatingCentreAddress String?
  phone                  String?
  website                String?
  contactName            String?
  contactEmail           String?
  onboardingStatus       OnboardingStatus @default(PENDING_DVLA)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  vehicles    Vehicle[]
  drivers     Driver[]
  documents   Document[]
  depotVisits DepotVisit[]
  todos       Todo[]
  ocrsScores  OcrsScore[]
}

model Vehicle {
  id                String    @id @default(cuid())
  clientId          String
  registration      String
  type              String?
  pmiDueDate        DateTime?
  brakeTestDueDate  DateTime?
  ebpmsFlag         Boolean   @default(false)
  motDueDate        DateTime?
  vedDueDate        DateTime?
  insuranceDueDate  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documents Document[]
  todos     Todo[]

  @@unique([clientId, registration])
}

model Driver {
  id                  String    @id @default(cuid())
  clientId            String
  name                String
  licenceCheckDueDate DateTime?
  cpcDueDate          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documents Document[]
  todos     Todo[]
}

model Document {
  id           String       @id @default(cuid())
  clientId     String
  vehicleId    String?
  driverId     String?
  type         DocumentType
  fileName     String
  filePath     String
  uploadDate   DateTime     @default(now())
  validUntil   DateTime?
  createdAt    DateTime     @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
}

model DepotVisit {
  id             String         @id @default(cuid())
  clientId       String
  date           DateTime
  findings       String?
  actionsAgreed  String?
  owner          String?
  followUpStatus FollowUpStatus @default(NONE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  todos  Todo[]
}

model Todo {
  id           String        @id @default(cuid())
  type         TodoType
  // Which requirement this is about, for MISSING_DOCUMENT/OVERDUE_DOCUMENT
  // todos — a vehicle can be missing several document types at once, so
  // type + vehicleId alone isn't enough to tell them apart.
  documentType DocumentType?
  description  String
  clientId     String
  vehicleId    String?
  driverId     String?
  depotVisitId String?
  status       TodoStatus    @default(OPEN)
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehicle    Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver     Driver?     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  depotVisit DepotVisit? @relation(fields: [depotVisitId], references: [id], onDelete: Cascade)
}

// Manual entry only — VOL has no public API for OCRS (see Phase 2 spec).
// Scores/band are whatever the TM reads off VOL that month.
model OcrsScore {
  id                  String   @id @default(cuid())
  clientId            String
  dateRecorded        DateTime
  roadworthinessScore Int
  trafficScore        Int
  band                OcrsBand
  createdAt           DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum EmailConnectionStatus {
  UNTESTED
  CONNECTED
  ERROR
}

// Phase 4 stage A (read-only). No "TM" field yet — single-tenant, like
// everything else in this build. Passwords are encrypted at rest
// (server/src/lib/crypto.ts) and never returned by the API.
model EmailAccount {
  id                    String                @id @default(cuid())
  label                 String
  imapHost              String
  imapPort              Int
  imapUsername          String
  imapPasswordEncrypted String
  imapSecure            Boolean               @default(true)
  smtpHost              String
  smtpPort              Int
  smtpUsername          String
  smtpPasswordEncrypted String
  smtpSecure            Boolean               @default(true)
  connectionStatus      EmailConnectionStatus @default(UNTESTED)
  connectionError       String?
  lastSyncedAt          DateTime?
  // Highest IMAP UID processed by the auto-ingest pipeline so far — new
  // syncs only look at messages with a higher UID than this.
  lastProcessedUid      Int?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  ingestLogs EmailIngestLog[]
}

enum EmailIngestStatus {
  FILED
  SKIPPED_NO_CLIENT
  SKIPPED_NOT_DOCUMENT
  ERROR
}

// One row per email message the auto-ingest pipeline has looked at — not a
// review gate (filing happens immediately), just an audit trail so an
// auto-filed document is never a silent guess. See spec section 5.
model EmailIngestLog {
  id             String            @id @default(cuid())
  emailAccountId String
  messageUid     Int
  subject        String
  fromAddress    String
  clientId       String?
  status         EmailIngestStatus
  summary        String
  createdAt      DateTime          @default(now())

  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
}
